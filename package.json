{
  "name": "client-server-benchmark-foundation",
  "private": true,
  "type": "module",
  "workspaces": [
    "server",
    "ui/web"
  ],
  "scripts": {
    "dev": "concurrently -n server,web -c blue,green \"npm run dev:server\" \"npm run dev:web\"",
    "dev:server": "npm -w server run dev",
    "dev:web": "npm -w ui/web run dev",
    "build": "npm -w server run build && npm -w ui/web run build",
    "test": "npm -w server run test && npm -w ui/web run test",
    "lint": "eslint .",
    "format": "prettier -w .",
    "format:check": "prettier -c ."
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "concurrently": "^9.1.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "globals": "^15.13.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.0"
  }
}
